# Copy this file to .env and fill in as needed.

# Defaults to a local SQLite file for zero-config demo use.
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/rescueai
DATABASE_URL=sqlite:///./rescueai.db

# Optional: only needed if you wire the agents up to a real LLM instead of
# the built-in rule-based/explainable logic. Never commit a real key.
LLM_API_KEY=your_api_key_here
MODEL_NAME=your_model_name_here
